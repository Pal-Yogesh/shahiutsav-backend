{
  "name": "shahiutsav-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "ShahiUtsav Event Marketplace API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "npx prisma generate --config prisma7.config.ts",
    "db:migrate": "npx prisma migrate dev --config prisma7.config.ts",
    "db:push": "npx prisma db push --config prisma7.config.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "make-admin": "tsx src/scripts/make-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.27",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "resend": "^6.39.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
